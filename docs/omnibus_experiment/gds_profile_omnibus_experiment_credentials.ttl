@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv-owl: <https://w3id.org/dpv/owl#> .
@prefix gds: <http://www.gate-ai.eu/gds#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix role: <http://www.w3.org/ns/dx/prof/role/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sw: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ------------ Ontology/Profile Metadata ------------------ #

<https://www.gate-ai.eu/gds> a owl:Ontology, prof:Profile ;
    prof:isProfileOf <http://www.w3.org/ns/odrl/2/core> ;
    prof:hasResource gds:gds-ttl ;
    dcterms:title "ODRL Profile for GATE Data Space"@en ;
    vann:preferredNamespacePrefix "gds" ;
    vann:preferredNamespaceUri "http://www.gate-ai.eu/gds#" ;
    rdfs:label "ODRL Profile for GATE Data Space"@en ;
    owl:versionInfo "0.2-omnibus-credential-aware-prototype-0.2" ;
    dcterms:created "2025-12-23"^^xsd:date ;
    dcterms:modified "2026-11-05"^^xsd:date ;
    dcterms:creator "GATE Institute" ;
    dcterms:publisher "GATE Institute" ;
    dcterms:abstract "ODRL Profile for GATE Data Space"@en ;
    dcterms:description "ODRL Profile for GATE Data Space"@en ;
    sw:term_status "unstable"@en ;
    dcterms:source <http://www.w3.org/ns/odrl/2/>, <http://w3id.org/dpv/owl> .

gds:gds-ttl a prof:ResourceDescriptor ;
    prof:hasRole role:vocabulary ;
    prof:hasArtifact <https://www.gate-ai.eu/data-space/gate-data-space-profile/gds.ttl> ;
    dcterms:title "ODRL Profile for GATE Data Space Turtle Vocabulary"@en ;
    dcterms:format <https://www.iana.org/assignments/media-types/text/turtle> ;
    dcterms:conformsTo <https://www.w3.org/TR/turtle> .

<https://www.gate-ai.eu/gds#> a skos:Collection ;
    skos:prefLabel "ODRL Profile for GATE Data Space Concepts"@en ;
    skos:member gds:Participant ;
    skos:member gds:GovernanceAuthority ;
    skos:member gds:Operator ;
    skos:member gds:Process ;
    skos:member gds:PayToUse ;
    skos:member gds:Access ;
    skos:member gds:Distribute ;
    skos:member gds:Research ;
    skos:member gds:IndependentAnalysis ;
    skos:member gds:ProductDevelopment ;
    skos:member gds:Training ;
    skos:member gds:MaxConsumptionDate ;
    skos:member gds:ValidNDA ;
    skos:member gds:Name ;
    skos:member gds:MemberSince ;
    skos:member gds:Type ;
    skos:member gds:Location ;
    skos:member gds:Recipient ;
    skos:member gds:Amount ;
    skos:member gds:ResearchOrganisation ;
    skos:member gds:MunicipalDataProvider ;
    skos:member gds:ScientificResearchPurpose ;
    skos:member gds:ResearchRelatedTechnologyDevelopment ;
    skos:member gds:scientificResearchQualification ;
    skos:member gds:scientificKnowledgeContribution ;
    skos:member gds:societalKnowledgeAndWellbeingAim ;
    skos:member gds:systematicMethodology ;
    skos:member gds:scientificAndEthicalStandards ;
    skos:member gds:verifiableTransparentResults ;
    skos:member gds:researchAutonomyIndependence ;
    skos:member gds:article89Safeguards ;
    skos:member gds:article6LawfulBasis ;
    skos:member gds:article9Condition .

# ------------ Credential Representation Metadata ------------ #
# General, OPTIONAL annotation properties: usable on any RDF resource that
# represents an actual verifiable/attestable CLAIM (not limited to odrl:LeftOperand).
# `rdfs:domain` controls semantic/editor applicability; `credentialGroup`
# controls JSON nesting. They are intentionally independent.
# A group URI need not be defined in advance. An undeclared group uses its
# IRI local name as JSON object key unless a gds:jsonKey is provided.
# The presence of a group and datatype makes a concept eligible for schema
# generation; it does NOT imply a REQUIRED claim or a VERIFIED claim.

gds:credentialGroup a owl:AnnotationProperty ;
    rdfs:label "Credential group"@en ;
    rdfs:comment "Identifies the JSON group containing this claim, independently of its ODRL refinement domain."@en .

gds:claimDatatype a owl:AnnotationProperty ;
    rdfs:label "Credential claim datatype"@en ;
    rdfs:comment "Expected datatype of this claim; map xsd:boolean to a JSON Schema boolean, etc."@en .

gds:jsonKey a owl:AnnotationProperty ;
    rdfs:label "Optional credential JSON key override"@en ;
    rdfs:comment "Override the default JSON field name inferred from the local name of an RDF term."@en .

gds:parentCredentialGroup a owl:AnnotationProperty ;
    rdfs:label "Optional parent credential group"@en ;
    rdfs:comment "For future nested credential groups; follow this property recursively when constructing paths."@en .

# ------------ Actor/Party Concepts ------------------ #

### https://www.gate-ai.eu/gds#Participant
gds:Participant a rdfs:Class, skos:Concept;
  rdfs:subClassOf dpv-owl:Entity ;
  skos:broader dpv-owl:Entity ;
  rdfs:isDefinedBy gds: ;
  rdfs:label "[GATE] Participant of GATE Data Space"@en ;
  skos:definition "A Party / Party Collection representing (a) participant(s) of the GATE Data Space"@en .

### https://www.gate-ai.eu/gds#GovernanceAuthority
gds:GovernanceAuthority a rdfs:Class, skos:Concept;
  rdfs:subClassOf dpv-owl:Entity ;
  skos:broader dpv-owl:Entity ;
  rdfs:isDefinedBy gds: ;
  rdfs:label "[GATE] Governance Authority of GATE Data Space"@en ;
  skos:definition "A Party / Party Collection representing the GATE Data Space Governance Authority"@en .

### https://www.gate-ai.eu/gds#Operator
gds:Operator a rdfs:Class, skos:Concept;
  rdfs:subClassOf dpv-owl:Entity ;
  skos:broader dpv-owl:Entity ;
  rdfs:isDefinedBy gds: ;
  rdfs:label "[GATE] Operator of GATE Data Space"@en ;
  skos:definition "A Party / Party Collection representing (a) opeartor(s) of the GATE Data Space"@en .

gds:ResearchOrganisation a rdfs:Class, skos:Concept ;
    rdfs:subClassOf gds:Participant ;
    skos:broader gds:Participant ;
    rdfs:label "[GATE] Research organisation"@en ;
    skos:definition "A data space participant acting as a research organisation. This label does not establish legal research qualification."@en ;
    rdfs:isDefinedBy gds: .

gds:MunicipalDataProvider a rdfs:Class, skos:Concept ;
    rdfs:subClassOf gds:Participant ;
    skos:broader gds:Participant ;
    rdfs:label "[GATE] Municipal data provider"@en ;
    skos:definition "A municipal or public-sector participant providing urban data."@en ;
    rdfs:isDefinedBy gds: .

# ------------ Action Concepts ------------------ #

### https://www.gate-ai.eu/gds#Process
gds:Process a odrl:Action, skos:Concept ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "[GATE] Process"@en ;
    odrl:includedIn odrl:use ;
    skos:definition "To carry out a series of actions to achieve a result"@en .

### https://www.gate-ai.eu/gds#PayToUse
gds:PayToUse a odrl:Action, skos:Concept ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "[GATE] Pay to use"@en ;
    odrl:includedIn odrl:use ;
    skos:definition "To pay in order to use a resource"@en .

### https://www.gate-ai.eu/gds#Access
gds:Access a odrl:Action, skos:Concept ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "[GATE] Access"@en ;
    odrl:includedIn odrl:use ;
    skos:definition "To obtain / read a resource"@en .

### https://www.gate-ai.eu/gds#Distribute
gds:Distribute a odrl:Action, skos:Concept ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "[GATE] Distribute"@en ;
    odrl:includedIn odrl:transfer ;
    skos:definition "To redistribute / share a resource"@en .

# ------------ Purpose Concepts ------------------ #

### https://www.gate-ai.eu/gds#Research
gds:Research a rdfs:Class, skos:Concept, dpv-owl:Purpose ;
    rdfs:isDefinedBy gds: ;
    skos:broader dpv-owl:Purpose ;
    rdfs:label "[GATE] Research"@en ;
    skos:definition "Processing of data for the purpose of research"@en .

### https://www.gate-ai.eu/gds#IndependentAnalysis
gds:IndependentAnalysis a rdfs:Class, skos:Concept, dpv-owl:Purpose ;
    rdfs:isDefinedBy gds: ;
    skos:broader dpv-owl:Purpose ;
    rdfs:label "[GATE] Independent analysis"@en ;
    skos:definition "To analyze data independently for one's own purposes"@en .

### https://www.gate-ai.eu/gds#ProductDevelopment
gds:ProductDevelopment a rdfs:Class, skos:Concept, dpv-owl:Purpose ;
    rdfs:isDefinedBy gds: ;
    skos:broader dpv-owl:Purpose ;
    rdfs:label "[GATE] Product Development"@en ;
    skos:definition "To use data to develop or improve products, services, or solutions."@en .

### https://www.gate-ai.eu/gds#Training
gds:Training a rdfs:Class, skos:Concept, dpv-owl:Purpose ;
    rdfs:isDefinedBy gds: ;
    skos:broader dpv-owl:Purpose ;
    rdfs:label "[GATE] Training"@en ;
    skos:definition "To use data to train or validate models, algorithms, or systems."@en .

gds:ScientificResearchPurpose a rdfs:Class, skos:Concept, dpv-owl:Purpose ;
    skos:broader gds:Research ;
    rdfs:label "[GATE] Scientific research (declared purpose)"@en ;
    skos:definition "A declared purpose of scientific research; its qualification remains subject to the relevant assessment."@en ;
    rdfs:isDefinedBy gds: .

gds:ResearchRelatedTechnologyDevelopment a rdfs:Class, skos:Concept, dpv-owl:Purpose ;
    skos:broader gds:Research ;
    rdfs:label "[GATE] Research-related technology development (declared purpose)"@en ;
    skos:definition "Declared research-related technology development without an automatic determination that the legal research criteria are met."@en ;
    rdfs:isDefinedBy gds: .

# ------------ Omnibus policy concepts ------------------ #
# V1 models the current-GDPR scenario; V2 models the proposed Omnibus.
# These statements describe the verification attributes; they do not attest
# to legal compliance or imply that the proposed Digital Omnibus is enacted.

gds:scientificResearchQualification a odrl:LeftOperand, owl:NamedIndividual, skos:Concept ;
    rdfs:label "[GATE] Scientific research qualification"@en ;
    skos:definition "Assessed qualification of the intended activity as scientific research under the applicable legal framework."@en ;
    skos:scopeNote "V1. The research activity must be assessed; a declaration of research purpose is not sufficient."@en ;
    rdfs:domain gds:Process ;
    rdfs:isDefinedBy gds: ;
    gds:credentialGroup gds:Research ;
    gds:claimDatatype xsd:boolean .

gds:scientificKnowledgeContribution a odrl:LeftOperand, owl:NamedIndividual, skos:Concept ;
    rdfs:label "[GATE] Scientific knowledge contribution"@en ;
    skos:definition "Assessed contribution of the activity to scientific knowledge."@en ;
    skos:scopeNote "V2 proposed Digital Omnibus research criteria."@en ;
    rdfs:domain gds:Research ;
    rdfs:isDefinedBy gds: ;
    gds:credentialGroup gds:Research ;
    gds:claimDatatype xsd:boolean .

gds:societalKnowledgeAndWellbeingAim a odrl:LeftOperand, owl:NamedIndividual, skos:Concept ;
    rdfs:label "[GATE] Societal knowledge and well-being aim"@en ;
    skos:definition "Assessed aim to contribute to knowledge and societal well-being."@en ;
    skos:scopeNote "V2 proposed Digital Omnibus research criteria."@en ;
    rdfs:domain gds:Research ;
    rdfs:isDefinedBy gds: ;
    gds:credentialGroup gds:Research ;
    gds:claimDatatype xsd:boolean .

gds:systematicMethodology a odrl:LeftOperand, owl:NamedIndividual, skos:Concept ;
    rdfs:label "[GATE] Systematic methodology"@en ;
    skos:definition "Assessed use of a systematic research methodology."@en ;
    skos:scopeNote "V2 proposed Digital Omnibus research criteria."@en ;
    rdfs:domain gds:Research ;
    rdfs:isDefinedBy gds: ;
    gds:credentialGroup gds:Research ;
    gds:claimDatatype xsd:boolean .

gds:scientificAndEthicalStandards a odrl:LeftOperand, owl:NamedIndividual, skos:Concept ;
    rdfs:label "[GATE] Scientific and ethical standards"@en ;
    skos:definition "Assessed adherence to applicable scientific and ethical standards."@en ;
    skos:scopeNote "V2 proposed Digital Omnibus research criteria."@en ;
    rdfs:domain gds:Research ;
    rdfs:isDefinedBy gds: ;
    gds:credentialGroup gds:Research ;
    gds:claimDatatype xsd:boolean .

gds:verifiableTransparentResults a odrl:LeftOperand, owl:NamedIndividual, skos:Concept ;
    rdfs:label "[GATE] Verifiable and transparent results"@en ;
    skos:definition "Assessed verifiability and transparency of the research results."@en ;
    skos:scopeNote "V2 proposed Digital Omnibus research criteria."@en ;
    rdfs:domain gds:Research ;
    rdfs:isDefinedBy gds: ;
    gds:credentialGroup gds:Research ;
    gds:claimDatatype xsd:boolean .

gds:researchAutonomyIndependence a odrl:LeftOperand, owl:NamedIndividual, skos:Concept ;
    rdfs:label "[GATE] Research autonomy and independence"@en ;
    skos:definition "Assessed autonomy and independence of the research organisation in the context of the activity."@en ;
    skos:scopeNote "V2 proposed Digital Omnibus research criteria; the organisation is not presumed independent merely because of its type."@en ;
    rdfs:domain gds:Participant ;
    rdfs:isDefinedBy gds: ;
    gds:credentialGroup gds:ResearchOrganisation ;
    gds:claimDatatype xsd:boolean .

gds:article89Safeguards a odrl:LeftOperand, owl:NamedIndividual, skos:Concept ;
    rdfs:label "[GATE] GDPR Article 89 safeguards"@en ;
    skos:definition "Assessment that appropriate Article 89(1) safeguards are in place for the intended processing."@en ;
    skos:scopeNote "Both V1 and V2. This is activity- and dataset-sensitive; it is not a blanket organisation-wide approval."@en ;
    rdfs:domain gds:Participant ;
    rdfs:isDefinedBy gds: ;
    gds:credentialGroup gds:ProcessingCompliance ;
    gds:claimDatatype xsd:boolean .

gds:article6LawfulBasis a odrl:LeftOperand, owl:NamedIndividual, skos:Concept ;
    rdfs:label "[GATE] GDPR Article 6 lawful basis"@en ;
    skos:definition "Assessment that there is an applicable GDPR Article 6(1) lawful basis for the intended processing."@en ;
    skos:scopeNote "Both V1 and V2. Context-specific, not an inherent attribute of the participant."@en ;
    rdfs:domain gds:Participant ;
    rdfs:isDefinedBy gds: ;
    gds:credentialGroup gds:ProcessingCompliance ;
    gds:claimDatatype xsd:boolean .

# Optional Article 9 claim from the source legal-check table.
# Not annotated with credentialGroup/claimDatatype: omitted from the demo schema.
gds:article9Condition a odrl:LeftOperand, owl:NamedIndividual, skos:Concept ;
    rdfs:label "[GATE] GDPR Article 9 condition (if applicable)"@en ;
    skos:definition "Assessment of a suitable Article 9 condition where special-category personal data are processed."@en ;
    rdfs:domain gds:Participant ;
    rdfs:isDefinedBy gds: ;
    gds:credentialGroup gds:ProcessingCompliance ;
    gds:claimDatatype xsd:boolean .

# ------------ Existing Left Operand/Constraints Concepts ------------------ #

### https://www.gate-ai.eu/gds#MaxConsumptionDate
gds:MaxConsumptionDate a odrl:LeftOperand, owl:NamedIndividual, skos:Concept ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "[GATE] Max Consumption Date"@en ;
    skos:definition "Latest date/time at which the resource may be consumed."@en ;
    gds:credentialGroup gds:UsageConditions ;
    gds:claimDatatype xsd:dateTime ;
    gds:jsonKey "maxConsumptionDate" .

### https://www.gate-ai.eu/gds#ValidNDA
gds:ValidNDA a odrl:LeftOperand, owl:NamedIndividual, skos:Concept ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "[GATE] Valid Non-Disclosure Agreement"@en ;
    skos:definition "Specifies that a valid and active non-disclosure agreement must be in place for the permitted use of the resource."@en ;
    gds:credentialGroup gds:UsageConditions ;
    gds:claimDatatype xsd:boolean ;
    gds:jsonKey "validNDA" .

# ------------ Properties to be visualised as refinements ------------------ #

### https://www.gate-ai.eu/gds#Name
gds:Name a rdf:Property, skos:Concept ;
    rdfs:domain gds:Participant ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "[GATE] name"@en ;
    gds:credentialGroup gds:Participant ;
    gds:claimDatatype xsd:string ;
    gds:jsonKey "name" .

### https://www.gate-ai.eu/gds#MemberSince
gds:MemberSince a rdf:Property, skos:Concept ;
    rdfs:domain gds:Participant ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "[GATE] member since"@en ;
    gds:credentialGroup gds:Participant ;
    gds:claimDatatype xsd:dateTime ;
    gds:jsonKey "since" .

### https://www.gate-ai.eu/gds#Type
gds:Type a rdf:Property, skos:Concept ;
    rdfs:domain gds:Participant ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "[GATE] type"@en ;
    gds:credentialGroup gds:Participant ;
    gds:claimDatatype xsd:string ;
    gds:jsonKey "type" .

### https://www.gate-ai.eu/gds#Location
gds:Location a rdf:Property, skos:Concept ;
    rdfs:domain gds:Participant ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "[GATE] location"@en ;
    gds:credentialGroup gds:Participant ;
    gds:claimDatatype xsd:string ;
    gds:jsonKey "location" .

### https://www.gate-ai.eu/gds#Recipient
gds:Recipient a rdf:Property, skos:Concept ;
    rdfs:domain gds:PayToUse ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "[GATE] recipient"@en ;
    gds:credentialGroup gds:PayToUse ;
    gds:claimDatatype xsd:string ;
    gds:jsonKey "recipient" .

### https://www.gate-ai.eu/gds#Amount
gds:Amount a rdf:Property, skos:Concept ;
    rdfs:domain gds:PayToUse ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "[GATE] amount"@en ;
    gds:credentialGroup gds:PayToUse ;
    gds:claimDatatype xsd:decimal ;
    gds:jsonKey "amount" .

# ------------ Synthetic demonstration entities (not assertions of real compliance) ------------ #
# Representative synthetic parties/assets used for local demonstration.
# Do not interpret as real-world legal attestations.
<https://example.org/urbspace/municipality> a odrl:Party, gds:MunicipalDataProvider ;
    rdfs:label "Demo municipality (data provider)"@en .
<https://example.org/urbspace/researcher> a odrl:Party, gds:ResearchOrganisation ;
    rdfs:label "Demo research organisation (data consumer)"@en .
<https://example.org/urbspace/mobility-data> a odrl:Asset ;
    rdfs:label "Demo urban mobility dataset"@en .


# NOTE: gds:purposeCompatibility was intentionally excluded from the Omnibus example.

# NOTE: Existing Actor, Action and Purpose classes describe vocabulary, not
# scalar facts. If a role/action/purpose itself needs credential verification,
# define an explicit claim about that fact, then annotate it with the same two
# credential metadata properties (without changing parser logic).
