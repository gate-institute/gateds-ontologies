
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix prof:    <http://www.w3.org/ns/dx/prof/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix role:    <http://www.w3.org/ns/dx/prof/role/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix sw:      <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix gds:     <https://w3id.org/gds#> .

# ---------------------------------------------------------------------------
# GATE Data Spaces ODRL Profile v0.2.0 -- credential-enabled demo variant
# This extends the source profile with VCHub serialization annotations.
# Status-valued claims use xsd:string to match Policy V1/V2 rightOperand
# values such as "confirmed", "not_confirmed", and "verified".
# ---------------------------------------------------------------------------

<https://w3id.org/gds/profile> a owl:Ontology, prof:Profile ;
    dcterms:title "GATE Data Spaces ODRL Profile"@en ;
    dcterms:abstract "ODRL Profile for GATE Data Space"@en ;
    dcterms:description "ODRL Profile for GATE Data Space"@en ;
    rdfs:label "GATE Data Spaces ODRL Profile"@en ;
    rdfs:comment "Credential-enabled demonstration variant based on GDS profile v0.2.0; not a separately published profile version."@en ;
    prof:isProfileOf <http://www.w3.org/ns/odrl/2/core> ;
    prof:hasResource gds:gds-ttl ;
    vann:preferredNamespacePrefix "gds" ;
    vann:preferredNamespaceUri "https://w3id.org/gds#" ;
    owl:versionIRI <https://w3id.org/gds/profile/v0.2.0> ;
    owl:versionInfo "0.2.0" ;
    dcterms:created "2025-12-23"^^xsd:date ;
    dcterms:modified "2026-11-10"^^xsd:date ;
    dcterms:creator "GATE Institute, Sofia University" ;
    dcterms:publisher "GATE Institute, Sofia University" ;
    sw:term_status "unstable"@en ;
    dcterms:source <http://www.w3.org/ns/odrl/2/>, <http://w3id.org/dpv/owl> .

gds:gds-ttl a prof:ResourceDescriptor ;
    prof:hasRole role:vocabulary ;
    prof:hasArtifact <https://gate-institute.github.io/gateds-ontologies/gds/versions/v0.2.0/gds.ttl> ;
    dcterms:title "GATE Data Spaces ODRL Profile Turtle Vocabulary"@en ;
    dcterms:format <https://www.iana.org/assignments/media-types/text/turtle> ;
    dcterms:conformsTo <https://www.w3.org/TR/turtle> .

<https://w3id.org/gds#> a skos:Collection ;
    skos:prefLabel "GATE Data Spaces ODRL Profile Concepts"@en ;
    skos:member gds:Participant, gds:GovernanceAuthority, gds:Operator ;
    skos:member gds:Name, gds:MemberSince, gds:Type, gds:Location ;
    skos:member gds:ScientificResearchQualification, gds:Article89Safeguards,
        gds:Article6LawfulBasis ;
    skos:member gds:ScientificKnowledgeContribution,
        gds:SocietalKnowledgeAndWellbeingAim, gds:SystematicMethodology,
        gds:ScientificAndEthicalStandards, gds:VerifiableTransparentResults,
        gds:ResearchAutonomyIndependence ;
    skos:member gds:Research, gds:ProcessingCompliance .

# ---------------------------------------------------------------------------
# Credential annotation vocabulary: compatible with VCHub's extraction rules
# ---------------------------------------------------------------------------

gds:credentialGroup a owl:AnnotationProperty ;
    rdfs:label "Credential group"@en ;
    rdfs:comment "Identifies the JSON group containing this claim, independently of its ODRL refinement domain."@en .

gds:claimDatatype a owl:AnnotationProperty ;
    rdfs:label "Credential claim datatype"@en ;
    rdfs:comment "Expected datatype of this claim; map xsd:boolean to a JSON Schema boolean, etc."@en .

gds:parentCredentialGroup a owl:AnnotationProperty ;
    rdfs:label "Optional parent credential group"@en ;
    rdfs:comment "For future nested credential groups; follow this property recursively when constructing paths."@en .

gds:credentialRequired a owl:AnnotationProperty ;
    rdfs:label "Required credential claim"@en ;
    rdfs:comment "An optional xsd:boolean annotation on a claim: true requires the field to be present in an issued credential, while absence or false makes it optional; a required Boolean claim may still have the value false."@en .

# Optional vocabulary term supported by VCHub. No per-claim overrides are
# needed here: it lowercases the first character of each concept's local name.
gds:jsonKey a owl:AnnotationProperty ;
    rdfs:label "JSON serialization key"@en ;
    rdfs:comment "Optional override for the JSON property name of a claim or group."@en .

# Groups specify credentialSubject JSON object boundaries. In this example,
# no parentCredentialGroup links are declared, so each group is a root and
# generates its own credential schema in VCHub's grouped mode.
gds:Research a skos:Concept ;
    rdfs:label "Research evidence credential group"@en ;
    skos:definition "Claims used in assessing the qualification and conduct of scientific research."@en .

gds:ProcessingCompliance a skos:Concept ;
    rdfs:label "Processing compliance credential group"@en ;
    skos:definition "Claims establishing data-protection safeguards and a lawful basis for processing."@en .

# ---------------------------------------------------------------------------
# Actor / Party concepts
# ---------------------------------------------------------------------------

gds:Participant a odrl:Party, skos:Concept ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "Participant of GATE Data Space"@en ;
    skos:definition "A Party / Party Collection representing (a) participant(s) of the GATE Data Space"@en .

gds:GovernanceAuthority a odrl:Party, skos:Concept ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "Governance Authority of GATE Data Space"@en ;
    skos:definition "A Party / Party Collection representing the GATE Data Space Governance Authority"@en .

gds:Operator a odrl:Party, skos:Concept ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "Operator of GATE Data Space"@en ;
    skos:definition "A Party / Party Collection representing (a) operator(s) of the GATE Data Space"@en .

# ---------------------------------------------------------------------------
# Action and operator concepts reused from ODRL
# ---------------------------------------------------------------------------

odrl:use a odrl:Action, skos:Concept ;
    rdfs:isDefinedBy odrl: ;
    rdfs:label "Use"@en ;
    skos:definition "To use the Asset"@en ;
    skos:note "Use is the most generic action for all non-third-party usage. More specific types of the use action can be expressed by more targetted actions."@en .

odrl:transfer a odrl:Action, skos:Concept ;
    rdfs:isDefinedBy odrl: ;
    rdfs:label "Transfer Ownership"@en ;
    skos:definition "To transfer the ownership of the Asset in perpetuity."@en .

odrl:eq a odrl:Operator, owl:NamedIndividual, skos:Concept ;
    rdfs:isDefinedBy odrl: ;
    rdfs:label "Equal to"@en ;
    skos:definition "Indicating that a given value equals the right operand of the Constraint."@en .

odrl:neq a odrl:Operator, owl:NamedIndividual, skos:Concept ;
    rdfs:isDefinedBy odrl: ;
    rdfs:label "Not equal to"@en ;
    skos:definition "Indicating that a given value is not equal to the right operand of the Constraint."@en .

odrl:gt a odrl:Operator, owl:NamedIndividual, skos:Concept ;
    rdfs:isDefinedBy odrl: ;
    rdfs:label "Greater than"@en ;
    skos:definition "Indicating that a given value is greater than the right operand of the Constraint."@en .

odrl:lt a odrl:Operator, owl:NamedIndividual, skos:Concept ;
    rdfs:isDefinedBy odrl: ;
    rdfs:label "Less than"@en ;
    skos:definition "Indicating that a given value is less than the right operand of the Constraint."@en .

# ---------------------------------------------------------------------------
# Participant credential claims -- 4 claims, optional
# ---------------------------------------------------------------------------

gds:Name a odrl:LeftOperand, rdf:Property, skos:Concept ;
    skos:related gds:Participant ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "name"@en ;
    skos:definition "The name identifying a participant in the GATE Data Space."@en ;
    gds:credentialGroup gds:Participant ;
    gds:claimDatatype xsd:string .

gds:MemberSince a odrl:LeftOperand, rdf:Property, skos:Concept ;
    skos:related gds:Participant ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "member since"@en ;
    skos:definition "The date on which a participant became a member of the GATE Data Space."@en ;
    gds:credentialGroup gds:Participant ;
    gds:claimDatatype xsd:dateTime .

gds:Type a odrl:LeftOperand, rdf:Property, skos:Concept ;
    skos:related gds:Participant ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "type"@en ;
    skos:definition "The type or category of a participant in the GATE Data Space."@en ;
    gds:credentialGroup gds:Participant ;
    gds:claimDatatype xsd:string .

gds:Location a odrl:LeftOperand, rdf:Property, skos:Concept ;
    skos:related gds:Participant ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "location"@en ;
    skos:definition "The geographical location associated with a participant in the GATE Data Space."@en ;
    gds:credentialGroup gds:Participant ;
    gds:claimDatatype xsd:string .

# ---------------------------------------------------------------------------
# Scientific research qualification -- Policy V1
# ---------------------------------------------------------------------------

# Corrects two errors in the original v0.2.0 Turtle: the subject must be
# gds:ScientificResearchQualification (not gds:), and the definition predicate
# must be skos:definition (not skos:definitionScientificResearchQualification).
gds:ScientificResearchQualification a odrl:LeftOperand, rdf:Property, skos:Concept ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "scientific research qualification"@en ;
    skos:definition "Indicates whether an activity qualifies as scientific research under the GDPR."@en ;
    gds:credentialGroup gds:Research ;
    gds:claimDatatype xsd:string ;
    gds:credentialRequired true .

# ---------------------------------------------------------------------------
# Research eligibility criteria -- Policy V2
# ---------------------------------------------------------------------------

gds:ScientificKnowledgeContribution a odrl:LeftOperand, rdf:Property, skos:Concept ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "scientific knowledge contribution"@en ;
    skos:definition "Indicates whether the research has the potential to contribute to existing scientific knowledge or apply such knowledge in novel ways."@en ;
    gds:credentialGroup gds:Research ;
    gds:claimDatatype xsd:string ;
    gds:credentialRequired true .

gds:SocietalKnowledgeAndWellbeingAim a odrl:LeftOperand, rdf:Property, skos:Concept ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "societal knowledge and well-being aim"@en ;
    skos:definition "Indicates whether the research aims to advance collective knowledge or contribute to societal well-being."@en ;
    gds:credentialGroup gds:Research ;
    gds:claimDatatype xsd:string ;
    gds:credentialRequired true .

gds:SystematicMethodology a odrl:LeftOperand, rdf:Property, skos:Concept ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "systematic methodology"@en ;
    skos:definition "Indicates whether the research follows a methodical and systematic approach appropriate to its objectives."@en ;
    gds:credentialGroup gds:Research ;
    gds:claimDatatype xsd:string ;
    gds:credentialRequired true .

gds:ScientificAndEthicalStandards a odrl:LeftOperand, rdf:Property, skos:Concept ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "scientific and ethical standards"@en ;
    skos:definition "Indicates whether the research adheres to applicable scientific and ethical standards and recognised research practices."@en ;
    gds:credentialGroup gds:Research ;
    gds:claimDatatype xsd:string ;
    gds:credentialRequired true .

gds:VerifiableTransparentResults a odrl:LeftOperand, rdf:Property, skos:Concept ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "verifiable transparent results"@en ;
    skos:definition "Indicates whether the research methods and results are sufficiently transparent and documented to allow independent scrutiny and verification."@en ;
    gds:credentialGroup gds:Research ;
    gds:claimDatatype xsd:string ;
    gds:credentialRequired true .

gds:ResearchAutonomyIndependence a odrl:LeftOperand, rdf:Property, skos:Concept ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "research autonomy and independence"@en ;
    skos:definition "Indicates whether the research is conducted with appropriate autonomy and independence, free from undue influence."@en ;
    gds:credentialGroup gds:Research ;
    gds:claimDatatype xsd:string ;
    gds:credentialRequired true .

# ---------------------------------------------------------------------------
# Processing compliance -- shared by Policy V1 and Policy V2
# ---------------------------------------------------------------------------

gds:Article89Safeguards a odrl:LeftOperand, rdf:Property, skos:Concept ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "article 89 safeguards"@en ;
    skos:definition "Indicates whether appropriate technical and organisational safeguards are implemented in accordance with Article 89(1) of the GDPR."@en ;
    gds:credentialGroup gds:ProcessingCompliance ;
    gds:claimDatatype xsd:string ;
    gds:credentialRequired true .

gds:Article6LawfulBasis a odrl:LeftOperand, rdf:Property, skos:Concept ;
    rdfs:isDefinedBy gds: ;
    rdfs:label "article 6 lawful basis"@en ;
    skos:definition "Specifies the legal basis relied upon for processing personal data under Article 6(1) of the GDPR."@en ;
    gds:credentialGroup gds:ProcessingCompliance ;
    gds:claimDatatype xsd:string ;
    gds:credentialRequired true .

# ---------------------------------------------------------------------------
# Contextual relationships for the DIPS ODRL Editor
# These skos:related statements associate left operands with a selected
# action or party in the editor. They are NOT ODRL permissions or conditions.
# ---------------------------------------------------------------------------

# Left operands to offer when refining the ODRL Use action
gds:ScientificResearchQualification skos:related odrl:use .
gds:ScientificKnowledgeContribution skos:related odrl:use .
gds:SocietalKnowledgeAndWellbeingAim skos:related odrl:use .
gds:SystematicMethodology skos:related odrl:use .
gds:ScientificAndEthicalStandards skos:related odrl:use .
gds:VerifiableTransparentResults skos:related odrl:use .

# Left operands to offer when refining a GDS Participant
gds:Article89Safeguards skos:related gds:Participant .
gds:Article6LawfulBasis skos:related gds:Participant .
gds:ResearchAutonomyIndependence skos:related gds:Participant .
